; SD host controller driver (src\drivers\sdhcbcm): BCM2835 PDD over the CE
; standard SD host MDD. Requires the SD stack in the OS design (sdbus.dll,
; sdmemory.dll). Set BSP_NOSD=1 to leave it out.
IF BSP_NOSD !
    sdhcbcm.dll        $(_FLATRELEASEDIR)\sdhcbcm.dll                  NK     SHK
ENDIF BSP_NOSD !

; Analog audio driver (src\drivers\pwmaudio) for the Pi 1 3.5 mm jack.
; Optional: set BSP_AUDIO=1 (catalog item "Analog audio (Pi 1 3.5 mm jack)").
; Needs the Waveform Audio catalog item (waveapi.dll).
; @CESYSGEN IF CE_MODULES_WAVEAPI
IF BSP_NOAUDIO !
IF BSP_AUDIO
    pwmaudio.dll       $(_FLATRELEASEDIR)\pwmaudio.dll                 NK     SHK
ENDIF BSP_AUDIO
ENDIF BSP_NOAUDIO !
; @CESYSGEN ENDIF CE_MODULES_WAVEAPI

; @CESYSGEN ENDIF CE_MODULES_DEVICE

; CPU idle monitor demo (src\apps\idlemon): shows CPU load, idle % and
; GetIdleTime(). Optional: set BSP_IDLEMON=1 (catalog item "CPU Idle Monitor
; (demo)") to include it. platform.dat puts a shortcut on the desktop.
IF BSP_IDLEMON
    idlemon.exe        $(_FLATRELEASEDIR)\idlemon.exe                  NK
ENDIF BSP_IDLEMON

; Shut Down dialog (src\apps\poweroff): Restart / Power off / Cancel.
; Optional: set BSP_POWEROFF=1 (catalog item "Shut Down dialog
; (poweroff.exe)") to include it. platform.dat puts a shortcut on the desktop.
IF BSP_POWEROFF
    poweroff.exe       $(_FLATRELEASEDIR)\poweroff.exe                 NK
ENDIF BSP_POWEROFF

; Audio test (src\apps\audiotest): waveOut tones and PlaySound. Optional:
; set BSP_AUDIOTEST=1 (catalog item "Audio test (audiotest.exe)").
; platform.dat puts a shortcut on the desktop.
; @CESYSGEN IF CE_MODULES_WAVEAPI
IF BSP_NOAUDIO !
IF BSP_AUDIOTEST
    audiotest.exe      $(_FLATRELEASEDIR)\audiotest.exe                NK
ENDIF BSP_AUDIOTEST
ENDIF BSP_NOAUDIO !
; @CESYSGEN ENDIF CE_MODULES_WAVEAPI

; Volume tray icon (src\apps\voltray): speaker icon in the taskbar, click for
; a volume slider and Mute. Optional: set BSP_VOLTRAY=1 (catalog item "Volume
; tray icon (voltray.exe)"). platform.dat starts it from \Windows\Startup (no
; desktop shortcut).
; @CESYSGEN IF CE_MODULES_WAVEAPI
IF BSP_NOAUDIO !
IF BSP_VOLTRAY
    voltray.exe        $(_FLATRELEASEDIR)\voltray.exe                  NK
ENDIF BSP_VOLTRAY
ENDIF BSP_NOAUDIO !
; @CESYSGEN ENDIF CE_MODULES_WAVEAPI

; Modules loaded from the SD card instead of the image (catalog item "Load
; optional modules from the SD card", BSP_SDOFFLOAD=1, which needs
; BSP_SDROOT=1). With it set, PostFmergeBib.bat (sdoffload.js) removes each
; MODULES entry named on a "; SDOFFLOAD <name>" line below from ce.bib before
; romimage, and mksdcard.js copies the module into the sdcard\Windows build
; folder; with the card as root it then appears in \Windows. These lines are
; comments, so without the item they change nothing. Editing them changes
; this file, so makeimg rebuilds ce.bib and the list takes effect.
; Rules for a module on this list: nothing may need it before the SD card is
; mounted (early in boot phase 2), and none of the boot-phase-1 drivers may
; import it. Measured from a boot log: none of these load during boot.
; A module not in the image (catalog item not selected) is skipped with a
; warning, so the list may name optional components.
; IE7 / internet stack (pulled in as dependencies, about 4.1 MB):
; SDOFFLOAD ieframe.dll
; SDOFFLOAD wininet.dll
; SDOFFLOAD urlmon.dll
; SDOFFLOAD mlang.dll
; SDOFFLOAD wininetui.dll
; IE7 browser (catalog item Internet Explorer 7, about 11 MB; mshtml alone is
; 8.6 MB). PE import check: only these browser modules import each other and
; the stack above; nothing else in the image imports them.
; SDOFFLOAD mshtml.dll
; SDOFFLOAD mshtmled.dll
; SDOFFLOAD msls31.dll
; SDOFFLOAD imgutil.dll
; SDOFFLOAD pngfilt.dll
; SDOFFLOAD iesample.exe
; SDOFFLOAD inetcpl.cpl
; Network and dial-up tools (about 0.5 MB):
; SDOFFLOAD connmc.exe
; SDOFFLOAD rnaapp.exe
; SDOFFLOAD ping.exe
; SDOFFLOAD ipconfig.exe
; SDOFFLOAD route.exe
; SDOFFLOAD netstat.exe
; SDOFFLOAD net.exe
; SDOFFLOAD tracert.exe
; SDOFFLOAD ndisconfig.exe
; SDOFFLOAD ipv6.exe

; The FILES section describes any files that stored in the image but not
; fixed-up for execution by romimage.exe.  Applications in the FILES section
; will be fixed-up at run-time.
;

; The format is the same as the MODULES section.
FILES
;   Name        Path                                                                            Memory Flags
;   ----------  ------------------------------------------------------------------------------    -----------
    font.bmp    $(_FLATRELEASEDIR)\BootConsoleFont.8.bmp		  NK	U
; Boot splash (src\Common\VidConDebugOut\bootsplash.cpp). Must stay U (uncompressed).
    splash.bmp  $(_FLATRELEASEDIR)\splash_logo.24.bmp		  NK	U
    splashsm.bmp $(_FLATRELEASEDIR)\windowsce_rect.bmp		  NK	U
    ldbar.bmp   $(_FLATRELEASEDIR)\loading_bar.bmp		  NK	U
    ldfill.bmp  $(_FLATRELEASEDIR)\loading_bar_fill.bmp		  NK	U
IF BSP_IDLEMON
    idlemon.lnk $(_FLATRELEASEDIR)\idlemon.lnk		  NK	SH
ENDIF BSP_IDLEMON
IF BSP_POWEROFF
    poweroff.lnk $(_FLATRELEASEDIR)\poweroff.lnk		  NK	SH
ENDIF BSP_POWEROFF
; @CESYSGEN IF CE_MODULES_WAVEAPI
IF BSP_NOAUDIO !
IF BSP_AUDIOTEST
    audiotest.lnk $(_FLATRELEASEDIR)\audiotest.lnk		  NK	SH
ENDIF BSP_AUDIOTEST
IF BSP_VOLTRAY
    voltray.lnk $(_FLATRELEASEDIR)\voltray.lnk		  NK	SH
ENDIF BSP_VOLTRAY
ENDIF BSP_NOAUDIO !
; @CESYSGEN ENDIF CE_MODULES_WAVEAPI

