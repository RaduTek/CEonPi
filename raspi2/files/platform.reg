; This file contains all platform-specific registry entries for the
; BSP.  An example registry key is listed below.  The CESYSGEN and IF
; conditional statements operate in an identical fashion to platform.bib.
; Descriptions of these conditional mechanisms can be found in platform.bib.

; @CESYSGEN IF CE_MODULES_DEVICE

IF BSP_NOEXAMPLEREG !
[HKEY_LOCAL_MACHINE\ExamplePath]
    "ExampleString"="Hello"
    "ExampleDword"=dword:1
ENDIF BSP_NOEXAMPLEREG !

; @CESYSGEN ENDIF CE_MODULES_DEVICE


;------------ Display Driver -------------------------------------------------
; @CESYSGEN IF CE_MODULES_DISPLAY
; Display drivers are opt-in catalog items (mutually exclusive), see
; platform.bib: BSP_VC4DISP=1 (vc4disp.dll) or BSP_RASPIDISPLAY=1
; (raspibasic_ddi.dll); vc4disp wins if both are set. With neither, no BSP
; display driver is registered (headless, untested).
IF BSP_NODISPLAY !

IF BSP_VC4DISP
; CachedFrameBuffer: 1 = draw through the cached view of the framebuffer and
; write the touched rows back after each operation (fast screen reads:
; scrolling, window moves, cursor); 0 = draw uncached, as raspiBasic_ddi does.
; FastBlt: 1 = turn on Microsoft's optimized software blits in gpe.lib (32 bpp
; -> RGB565 copies, transparent copies, alpha blends; off by default in
; gpe.lib); 0 = leave them off.
; DriverBlt: 1 = vc4disp's own routines for 24/32 bpp -> RGB565 copies and
; DSTINVERT (vc4blt.cpp); 0 = leave those to gpe.lib's slow generic path.
; HwCursor: 1 = VideoCore hardware cursor overlay (vc4cursor.cpp; falls back
; to the software cursor if the firmware rejects it); 0 = software cursor.
[HKEY_LOCAL_MACHINE\Drivers\Display\vc4disp\Config]
    "DisplayDll"="vc4disp.dll"
    "CachedFrameBuffer"=dword:1
    "FastBlt"=dword:1
    "DriverBlt"=dword:1
    "HwCursor"=dword:1
; HwCursorInterval: shortest time between two hardware cursor moves, in ms.
; A cursor thread sends only the newest position, so a fast mouse costs at
; most one firmware call per interval (each call busy-waits in the OAL).
    "HwCursorInterval"=dword:8
; DmaBlt: 1 = large screen-to-screen copies and screen fills by DMA channel
; DISP_DMA_CHANNEL (vc4dma.cpp; turns itself off and logs on any DMA error);
; 0 = CPU only. DmaMinPixels: smallest rectangle that uses DMA (0x7FFFFFFF =
; set DMA up but never use it). DmaBurst: DMA burst length (0..15); KEEP 0:
; burst 8 lost the HDMI signal or hung the system, burst 2 hung the system
; once the audio DMA was running too.
; DmaBusOffset: physical -> VideoCore bus address (0xC0000000 + burst 8 hung).
    "DmaBlt"=dword:1
    "DmaMinPixels"=dword:4000
    "DmaBurst"=dword:0
    "DmaBusOffset"=dword:40000000
; DmaCopy: 1 = screen-to-screen copies by DMA too; 0 = fills only (with
; DmaBurst 0, DMA copies measured slower than the CPU: 52 vs 81 Mpix/s).
    "DmaCopy"=dword:0
; RawFrameBuffer: 1 = answer the GETRAWFRAMEBUFFER escape (vc4escape.cpp):
; apps such as TCPMP get the framebuffer mapped into their process and draw
; video straight to it; 0 = off. RawFbWriteCombine: 1 = map it
; write-combining (falls back to uncached), 0 = uncached.
    "RawFrameBuffer"=dword:1
    "RawFbWriteCombine"=dword:1
; OverlayProbe: 1 = test the firmware's "Set plane" tag (vc4overlay.cpp): 10 s
; after the desktop mode is set, show a scaled YUV colour-bar test image on an
; HVS plane for a few stages and log each result; 0 = off. Verified 2026-11-25.
    "OverlayProbe"=dword:0

[HKEY_LOCAL_MACHINE\System\GDI\Drivers]
    "Display"="vc4disp.dll"

; GWES will pass this value to the Display driver; the driver will open the
; key to which it points to read its configuration.
[HKEY_LOCAL_MACHINE\System\GDI\DisplayCandidates]
    "Candidate10"="Drivers\\Display\\vc4disp\\Config"
ENDIF BSP_VC4DISP

IF BSP_VC4DISP !
IF BSP_RASPIDISPLAY
[HKEY_LOCAL_MACHINE\Drivers\Display\raspiddibasic\Config]
    "DisplayDll"="raspibasic_ddi.dll"

[HKEY_LOCAL_MACHINE\System\GDI\Drivers]
    "Display"="raspibasic_ddi.dll"

; GWES will pass this value to the Display driver; the driver will open the
; key to which it points to read its configuration.
[HKEY_LOCAL_MACHINE\System\GDI\DisplayCandidates]
    "Candidate10"="Drivers\\Display\\raspiddibasic\\Config"
ENDIF BSP_RASPIDISPLAY
ENDIF BSP_VC4DISP !

; Settings to rotate the screen by 0 degrees clockwise upon download
[HKEY_LOCAL_MACHINE\System\GDI\Rotation]
    "Angle"=dword:0

; Let GWES save/restore video memory during suspend/resume
[HKEY_LOCAL_MACHINE\SYSTEM\GWE]
;   "PORepaint"=dword:0 - the display driver handles everything
;   "PORepaint"=dword:1 - gwe should save and restore the bits
;   "PORepaint"=dword:2 - gwe should invalidate and repaint
;   "PORepaint"=dword:3 - gwe and driver need to save video memory
    "PORepaint"=dword:1

ENDIF BSP_NODISPLAY !
; @CESYSGEN ENDIF CE_MODULES_DISPLAY
;-------------------------------------------------------------------------


;------------ My customization -------------------------------------------------
; Disable shell rect amimation 
[HKEY_LOCAL_MACHINE\SYSTEM\GWE]
	"Animate"=dword:0

; This registry setting controls display of the Explorer's suspend menu button
; To enable display of that button, comment out the next two lines.
; Enabled: on this BSP Suspend is the shutdown (OEMPowerOff halts the board
; through the firmware, see src\oal\oallib\power.c).
;[HKEY_LOCAL_MACHINE\Explorer]
;    "Suspend"=dword:0

; Never suspend on idle: Suspend halts the board (shutdown) on this BSP, so
; the power manager must not enter it by itself. 0 = never.
[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Power\Timeouts]
    "ACSuspendTimeout"=dword:0
    "BattSuspendTimeout"=dword:0


; USB - DesignWare OTG (DWC2) USB host controller driver (src\drivers\dwchci)
; Loaded at boot. Optional: set BSP_USBHOST=1 (catalog item "USB host
; controller (DWC OTG)"). BSP_NOUSB=1 (which also drops the stock USB stack)
; leaves it out too.
; DmaBusOffset is added to a physical address to get the bus address the
; controller uses for DMA (assumed 0x40000000 on the BCM2835, not verified).
; The IClass values are added once the driver creates a real HCD object.
; @CESYSGEN IF CE_MODULES_USBD
IF BSP_NOUSB !
IF BSP_USBHOST
[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\DWCUsbHost]
   "Prefix"="HCD"
   "Dll"="dwchci.dll"
   "Order"=dword:30
   "DmaBusOffset"=dword:40000000
ENDIF BSP_USBHOST
ENDIF BSP_NOUSB !
; @CESYSGEN ENDIF CE_MODULES_USBD

; SD host controller driver (src\drivers\sdhcbcm): the BCM2835 PDD over the CE
; standard SD host MDD. Optional: set BSP_SDHOST=1 (catalog item "SD card host
; controller (Arasan eMMC)").
; With BSP_SDROOT=1 (SD card as root file system, see below) the key goes into
; the boot hive so the device manager loads it in boot phase 1, together with
; the SD bus driver. ONLY then: the device manager loads every BuiltIn driver
; in the boot hive in phase 1 even with BootVars Flags=1, so without
; BSP_SDROOT (SD bus key not in the boot hive) the host would load before its
; bus driver and hit DEBUGCHK sdbus.hpp line 200 (g_pSdContainer == NULL).
; fmerge drops the marker comments inside a false IF.
; WARNING: never start a comment line with the boot-section marker text; the
; registry compiler treats such a line as a marker even if more text follows.
IF BSP_SDHOST
IF BSP_SDROOT
; HIVE BOOT SECTION
ENDIF BSP_SDROOT
[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\SDHCBcm]
   "Prefix"="SHC"
   "Dll"="sdhcbcm.dll"
   "Order"=dword:21
   ; The MDD looks up this exported factory to build the BCM2835 controller.
   "ObjectCreationProc"="CreateSDHCBcmObject"
   ; Arasan eMMC register window: 0x20300000, 256 bytes, on the Internal bus.
   "MemBase"=dword:20300000
   "MemLen"=dword:00000100
   "InterfaceType"=dword:0
   "BusNumber"=dword:0
   ; Static SysIntr for GPU IRQ 62, wired in the OAL as SYSINTR_SDHC (= 18).
   "SysIntr"=dword:12
   ; The Arasan capabilities register reads 0, so give the MDD the
   ; mailbox-reported EMMC base clock (200000000 = 0x0BEBC200). The data
   ; timeout counter runs off SDCLK, so 25 MHz (0x017D7840), not 200 MHz:
   ; 200 MHz makes the MDD compute a timeout control value of 0x10, which
   ; overflows the 4-bit register field to 0 (the minimum ~41 us window) and
   ; makes slower cards fail every data transfer with a Data Timeout (0x10).
   "BaseClockFrequency"=dword:0BEBC200
   "TimeoutClockFrequency"=dword:017D7840
   ; Keep DMA OFF - PIO only. The BCM2835 Arasan's built-in SDHCI SDMA/ADMA2
   ; does not work (it needs the external BCM DMA engine with EMMC DREQ pacing,
   ; which the CE standard MDD cannot drive): the engine arms but never moves
   ; data or raises a completion interrupt, hanging the first multi-block
   ; transfer. PIO is the working path. Do not clear this without first adding
   ; external-DMA-engine support. See the SD section of CLAUDE.md.
   "DisableDMA"=dword:1
   ; 1 = never switch cards to high speed (50 MHz); they stay at 25 MHz.
   ; The driver never sets the controller's High Speed Enable bit either way.
   "DisableHighSpeed"=dword:0
IF BSP_SDROOT
; END HIVE BOOT SECTION
ENDIF BSP_SDROOT
ENDIF BSP_SDHOST

;------------ SD card as root file system (BSP_SDROOT) -----------------------
; Catalog item "SD card as root file system" sets BSP_SDROOT=1. Needs the SD
; driver (BSP_SDHOST=1). See docs\sdroot.md.
;
; The FAT partition on the SD card (the boot partition: bootcode.bin,
; kernel.img, ...) is mounted as "\" instead of "\Storage Card". "\Windows" is
; then the card's Windows folder merged over the ROM image (a file on the card
; wins), so modules can live on the card. With the RAM file system the RAM
; object store keeps the registry hives (MountAsBootable stays on it) but is no
; longer the root; with the ROM-only file system the card is also the bootable
; volume and holds persistent hives (below).
;
; The card must be mounted before the shell starts, so the SD drivers load in
; boot phase 1: init\BootVars Flags bit 2 starts the device manager in phase 1,
; and the SD host, SD bus and SD memory keys are copied into the boot hive
; (the bus/memory values are verbatim from common.reg). "Flags"=1000
; (DEVFLAGS_BOOTPHASE_1, as ccfgsvc uses) loads the host and bus drivers in
; phase 1 only; without it the device manager would load a second instance in
; phase 2, because its duplicate check only compares device names.
;
; "Removable"=0 on the SD memory class keys (read by sdmemmain.cpp, default 1)
; stops the volume from reporting CE_VOLUME_ATTRIBUTE_REMOVABLE. The shell
; (shcore PathIsRemovableDevice) checks the volume of the first path component,
; so with a removable root volume every folder in "\" was drawn as a drive.
;
; AutoFormat/AutoPart are forced off: this card holds the boot files. The
; CleanBoot exclusion list protects the boot files and \Windows in case the
; file system ever performs a clean boot of the root volume (that code is in
; filesys.dll, which has no source here, so this is a precaution).
IF BSP_SDROOT
IF BSP_SDHOST
; HIVE BOOT SECTION
[HKEY_LOCAL_MACHINE\init\BootVars]
   ; 1 = storage manager, 2 = device manager in boot phase 1
   "Flags"=dword:3

; With the RAM file system (fsysram, the default): it stays mounted as
; \Object Store and keeps the registry hives, but is not the root. The key only
; exists with fsysram (common.reg), so do not create it otherwise.
; @CESYSGEN IF FILESYS_FSYSRAM
[HKEY_LOCAL_MACHINE\System\StorageManager\AutoLoad\ObjectStore]
   "MountAsRoot"=dword:0
; @CESYSGEN ENDIF FILESYS_FSYSRAM

[HKEY_LOCAL_MACHINE\System\StorageManager\Profiles\SDMemory]
   "Name"="SD Memory Card"
   "MountAsRoot"=dword:1
   "AutoFormat"=dword:0
   "AutoPart"=dword:0

[HKEY_LOCAL_MACHINE\System\StorageManager\Profiles\SDHCMemory]
   "Name"="SD Memory Card"
   "MountAsRoot"=dword:1
   "AutoFormat"=dword:0
   "AutoPart"=dword:0

; ROM-only file system (catalog item "ROM-only File System", no fsysram): no
; RAM object store, so the card is also the bootable volume. filesys then
; waits for it in boot phase 1 and keeps the registry hives (and default.vol)
; in the card's \Windows\Registry, so registry changes persist. The OAL
; answers IOCTL_HAL_GET_HIVE_CLEAN_FLAG with "keep". With old hives on the
; card, registry changes in a new kernel.img do not apply: delete
; \Windows\Registry on the card. See docs\sdroot.md.
; @CESYSGEN IF !FILESYS_FSYSRAM
[HKEY_LOCAL_MACHINE\System\StorageManager\Profiles\SDMemory]
   "MountAsBootable"=dword:1

[HKEY_LOCAL_MACHINE\System\StorageManager\Profiles\SDHCMemory]
   "MountAsBootable"=dword:1
; @CESYSGEN ENDIF !FILESYS_FSYSRAM

[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\SDHCBcm]
   "Flags"=dword:1000

[HKEY_LOCAL_MACHINE\Drivers\Builtin\SDBusDriver]
   "Order"=dword:15
   "Dll"="SDBus.dll"
   "Prefix"="SDC"
   "ThreadPriority"=dword:64
   "RequestListDepth"=dword:30
   "IClass"=multi_sz:"{20FA98A8-B298-4b32-8D72-C716AEE2FA84}=%b","{6F40791D-300E-44E4-BC38-E0E63CA8375C}=%b"
   "Flags"=dword:1000

[HKEY_LOCAL_MACHINE\Drivers\SDCARD\ClientDrivers\Class\SDMemory_Class]
   "Dll"="SDMemory.dll"
   "Prefix"="DSK"
   "BlockTransferSize"=dword:40
   "Profile"="SDMemory"
   "Removable"=dword:0
   "IClass"=multi_sz:"{A4E7EDDA-E575-4252-9D6B-4195D48BB865}","{8DD679CE-8AB4-43c8-A14A-EA4963FAA715}"

[HKEY_LOCAL_MACHINE\Drivers\SDCARD\ClientDrivers\Class\SDMemory_Class\High_Capacity]
   "Dll"="SDMemory.dll"
   "Prefix"="DSK"
   "BlockTransferSize"=dword:40
   "Profile"="SDHCMemory"
   "Removable"=dword:0
   "IClass"=multi_sz:"{A4E7EDDA-E575-4252-9D6B-4195D48BB865}","{8DD679CE-8AB4-43c8-A14A-EA4963FAA715}"

[HKEY_LOCAL_MACHINE\System\StorageManager\CleanBoot\FileExclusionList]
   "\\bootcode.bin"=dword:0
   "\\start.elf"=dword:0
   "\\fixup.dat"=dword:0
   "\\start_cd.elf"=dword:0
   "\\fixup_cd.dat"=dword:0
   "\\config.txt"=dword:0
   "\\kernel.img"=dword:0
   "\\overlays"=dword:0
   "\\Windows"=dword:0
; END HIVE BOOT SECTION
ENDIF BSP_SDHOST
ENDIF BSP_SDROOT

; Analog audio - Pi 1 3.5 mm jack (src\drivers\pwmaudio). PWM on GPIO40/45
; fed by DMA channel 4. Optional: catalog item "Analog audio (Pi 1 3.5 mm
; jack)" sets BSP_AUDIO=1; needs the Waveform Audio catalog item. See
; docs\audio.md.
; @CESYSGEN IF CE_MODULES_WAVEAPI
IF BSP_NOAUDIO !
IF BSP_AUDIO
[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\PwmAudio]
   "Prefix"="WAV"
   "Dll"="pwmaudio.dll"
   "Index"=dword:1
   "Order"=dword:30
   ; Static SysIntr for DMA channel 4 (GPU IRQ 20), wired in the OAL as
   ; SYSINTR_AUDIO (= 19).
   "SysIntr"=dword:13
   ; Physical to VideoCore bus address offset for the DMA buffer (as dwchci).
   "DmaBusOffset"=dword:40000000
   ; 1 = at load, play 0.5 s 440 Hz on the left, then 0.5 s 880 Hz on the
   ; right (hardware bring-up test; verified on a Pi 1 Model B).
   "TestTone"=dword:0
   ; Audio IST priority (110), read by the MDD and the test tone. Must be
   ; above the boot/NDIS threads (251) and SMSC95XX data threads (130):
   ; at 251 heavy KITL output during boot made the refill miss deadlines
   ; (crackle). USB's IST stays above it at 101.
   "Priority256"=dword:6E
   ; Requantisation of 16-bit samples to the PWM range (~11.5 bits at
   ; 44.1 kHz): 0 = truncate, 1 = TPDF dither, 2 = TPDF dither + 1st-order
   ; noise shaping (driver default). Read when the driver loads.
   "Dither"=dword:2
   ; Publish the audio device interface for waveapi.
   "IClass"=multi_sz:"{37168569-61C4-45fd-BD54-9442C7DBA46F}"
ENDIF BSP_AUDIO
ENDIF BSP_NOAUDIO !
; @CESYSGEN ENDIF CE_MODULES_WAVEAPI

; USB Ethernet - SMSC LAN9512/LAN9514 (src\drivers\smsc95xx), the on-board
; Ethernet of the Pi 1 Model B/B+. USBD loads it for the Ethernet function,
; VID 0x0424 (1060) / PID 0xEC00 (60416). Optional: set BSP_ETHERNET=1
; (catalog item "USB Ethernet (SMSC LAN95xx)"), needs BSP_USBHOST=1. BSP_NOUSB=1
; leaves it out.
; @CESYSGEN IF CE_MODULES_USBD
IF BSP_NOUSB !
IF BSP_USBHOST
IF BSP_ETHERNET
[HKEY_LOCAL_MACHINE\Drivers\USB\LoadClients\1060_60416\Default\Default\SMSC95XX]
   "DLL"="smsc95xx.dll"
[HKEY_LOCAL_MACHINE\Drivers\USB\ClientDrivers\SMSC95XX]
   "DLL"="smsc95xx.dll"

; The same DLL is the NDIS miniport. After USB attach the driver calls
; NdisRegisterAdapter("SMSC95XX", "SMSC95XX1"); NDIS finds the DLL through
; Comm\SMSC95XX. Deliberately no Comm\SMSC95XX\Linkage\Route: the adapter must
; not be brought up at boot before the USB device exists.
[HKEY_LOCAL_MACHINE\Comm\SMSC95XX]
   "DisplayName"="SMSC LAN95xx USB Ethernet"
   "Group"="NDIS"
   "ImagePath"="smsc95xx.dll"

[HKEY_LOCAL_MACHINE\Comm\SMSC95XX1]
   "DisplayName"="SMSC LAN95xx USB Ethernet"
   "Group"="NDIS"
   "ImagePath"="smsc95xx.dll"

; Optional "NetworkAddress"="0252506900AB" here overrides the firmware MAC.
[HKEY_LOCAL_MACHINE\Comm\SMSC95XX1\Parms]
   "BusNumber"=dword:0
   "BusType"=dword:0

[HKEY_LOCAL_MACHINE\Comm\SMSC95XX1\Parms\TcpIp]
   "EnableDHCP"=dword:1
   "IpAddress"="0.0.0.0"
   "Subnetmask"="0.0.0.0"
   "DefaultGateway"="0.0.0.0"
   "UseZeroBroadcast"=dword:0
ENDIF BSP_ETHERNET
ENDIF BSP_USBHOST
ENDIF BSP_NOUSB !
; @CESYSGEN ENDIF CE_MODULES_USBD

; USB - default class driver for debugging
[HKEY_LOCAL_MACHINE\Drivers\USB\LoadClients\Default\Default\Default\GenUSB]
   "DLL"="GenUSB.DLL"
