; This file contains all platform-specific registry entries for the
; BSP.  An example registry key is listed below.  The CESYSGEN and IF
; conditional statements operate in an identical fashion to platform.bib.
; Descriptions of these conditional mechanisms can be found in platform.bib.

; @CESYSGEN IF CE_MODULES_DEVICE

IF BSP_NOEXAMPLEREG !
[HKEY_LOCAL_MACHINE\ExamplePath]
    "ExampleString"="Hello"
    "ExampleDword"=dword:1
ENDIF BSP_NOEXAMPLEREG !

; @CESYSGEN ENDIF CE_MODULES_DEVICE


;------------ Display Driver -------------------------------------------------
; @CESYSGEN IF CE_MODULES_DISPLAY
IF BSP_NODISPLAY !

IF BSP_NORASPIDISPLAY !
[HKEY_LOCAL_MACHINE\Drivers\Display\raspiddibasic\Config]
    "DisplayDll"="raspibasic_ddi.dll"

[HKEY_LOCAL_MACHINE\System\GDI\Drivers]
    "Display"="raspibasic_ddi.dll"

; Settings to rotate the screen by 0 degrees clockwise upon download
[HKEY_LOCAL_MACHINE\System\GDI\Rotation]
    "Angle"=dword:0

; GWES will pass this value to the Display driver; the driver will open the
; key to which it points to read its configuration.
[HKEY_LOCAL_MACHINE\System\GDI\DisplayCandidates]
    "Candidate10"="Drivers\\Display\\raspiddibasic\\Config"

; Let GWES save/restore video memory during suspend/resume
[HKEY_LOCAL_MACHINE\SYSTEM\GWE]
;   "PORepaint"=dword:0 - the display driver handles everything
;   "PORepaint"=dword:1 - gwe should save and restore the bits
;   "PORepaint"=dword:2 - gwe should invalidate and repaint
;   "PORepaint"=dword:3 - gwe and driver need to save video memory
    "PORepaint"=dword:1

ENDIF BSP_NORASPIDISPLAY !

ENDIF BSP_NODISPLAY !
; @CESYSGEN ENDIF CE_MODULES_DISPLAY
;-------------------------------------------------------------------------


;------------ My customization -------------------------------------------------
; Disable shell rect amimation 
[HKEY_LOCAL_MACHINE\SYSTEM\GWE]
	"Animate"=dword:0

; This registry setting controls display of the Explorer's suspend menu button
; To enable display of that button, comment out the next two lines.
[HKEY_LOCAL_MACHINE\Explorer]
    "Suspend"=dword:0


; USB - DesignWare OTG (DWC2) USB host controller driver (src\drivers\dwchci)
; Loaded at boot. Set BSP_NOUSB=1 to leave it out.
; DmaBusOffset is added to a physical address to get the bus address the
; controller uses for DMA (assumed 0x40000000 on the BCM2835, not verified).
; The IClass values are added once the driver creates a real HCD object.
; @CESYSGEN IF CE_MODULES_USBD
IF BSP_NOUSB !
[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\DWCUsbHost]
   "Prefix"="HCD"
   "Dll"="dwchci.dll"
   "Order"=dword:30
   "DmaBusOffset"=dword:40000000
ENDIF BSP_NOUSB !
; @CESYSGEN ENDIF CE_MODULES_USBD

; SD host controller driver (src\drivers\sdhcbcm): the BCM2835 PDD over the CE
; standard SD host MDD. Set BSP_NOSD=1 to leave it out.
IF BSP_NOSD !
[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\SDHCBcm]
   "Prefix"="SHC"
   "Dll"="sdhcbcm.dll"
   "Order"=dword:21
   ; The MDD looks up this exported factory to build the BCM2835 controller.
   "ObjectCreationProc"="CreateSDHCBcmObject"
   ; Arasan eMMC register window: 0x20300000, 256 bytes, on the Internal bus.
   "MemBase"=dword:20300000
   "MemLen"=dword:00000100
   "InterfaceType"=dword:0
   "BusNumber"=dword:0
   ; Static SysIntr for GPU IRQ 62, wired in the OAL as SYSINTR_SDHC (= 18).
   "SysIntr"=dword:12
   ; The Arasan capabilities register reads 0, so give the MDD the
   ; mailbox-reported EMMC base clock (200000000 = 0x0BEBC200) and a timeout
   ; clock. BaseClockFrequency/TimeoutClockFrequency override the caps fields.
   "BaseClockFrequency"=dword:0BEBC200
   "TimeoutClockFrequency"=dword:0BEBC200
   ; Bring the stack up in PIO first (M1). DMA (SDMA + the VideoCore bus-address
   ; offset) is enabled in M2 by clearing this.
   "DisableDMA"=dword:1
ENDIF BSP_NOSD !

; Placeholder for Network driver
[HKEY_LOCAL_MACHINE\Drivers\USB\LoadClients\1060_60416\Default\Default\STDMICROETHCTLR]
   "Prefix"="TST"
   "Dll"="testdrv.dll"
[HKEY_LOCAL_MACHINE\Drivers\USB\ClientDrivers\STDMICROETHCTLR]
   "Prefix"="TST"
   "Dll"="testdrv.dll"




; Test driver
[HKEY_LOCAL_MACHINE\Drivers\TestDrvr]
   "Prefix"="TST"
   "Dll"="testdrv.dll"

; Test driver 1
[HKEY_LOCAL_MACHINE\Drivers\DrvrTest]
   "Prefix"="TST"
   "Dll"="drvrtest.dll"

; USB - default class driver for debugging
[HKEY_LOCAL_MACHINE\Drivers\USB\LoadClients\Default\Default\Default\GenUSB]
   "DLL"="GenUSB.DLL"
