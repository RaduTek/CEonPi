; This file defines custom values for the RAM-based filesystem.  It can be
; left blank.  Look at files in public\*\oak\files\*.dat for references on
; how to implement custom values.
; CPU idle monitor demo: desktop shortcut (optional, BSP_IDLEMON=1)
IF BSP_IDLEMON
Directory("\Windows\Desktop"):-File("CPU Idle Monitor.lnk","\Windows\idlemon.lnk")
ENDIF BSP_IDLEMON

; Shut Down dialog: desktop shortcut (optional, BSP_POWEROFF=1)
IF BSP_POWEROFF
Directory("\Windows\Desktop"):-File("Shut Down.lnk","\Windows\poweroff.lnk")
ENDIF BSP_POWEROFF

; GDI benchmark: desktop shortcut (optional, BSP_GDIBENCH=1)
IF BSP_GDIBENCH
Directory("\Windows\Desktop"):-File("GDI Benchmark.lnk","\Windows\gdibench.lnk")
ENDIF BSP_GDIBENCH

; Video overlay test: desktop shortcut (optional, BSP_OVLTEST=1)
IF BSP_OVLTEST
Directory("\Windows\Desktop"):-File("Overlay Test.lnk","\Windows\ovltest.lnk")
ENDIF BSP_OVLTEST

; Audio test: desktop shortcut (optional, BSP_AUDIOTEST=1)
IF BSP_NOAUDIO !
IF BSP_AUDIOTEST
Directory("\Windows\Desktop"):-File("Audio Test.lnk","\Windows\audiotest.lnk")
ENDIF BSP_AUDIOTEST
ENDIF BSP_NOAUDIO !

; Volume tray icon: started by Explorer from the Startup folder (optional,
; BSP_VOLTRAY=1). No desktop shortcut. The folder is the "StartUp" entry of
; HKLM\System\Explorer\Shell Folders (\Windows\StartUp); nothing else in this
; OS design creates it.
IF BSP_NOAUDIO !
IF BSP_VOLTRAY
Directory("\Windows"):-Directory("StartUp")
Directory("\Windows\StartUp"):-File("Volume.lnk","\Windows\voltray.lnk")
ENDIF BSP_VOLTRAY
ENDIF BSP_NOAUDIO !
