# BCM2835 SD host controller driver (src\drivers\sdhcbcm).
#
# Thin PDD over the CE standard SD host controller MDD (SDHCBase.lib) plus the
# SD card/bus helper libs. Building this REQUIRES the SD stack in the OS design
# (SD Bus Driver + SD Memory + Standard SDHC Host Controller catalog items), so
# that SDHCBase.lib / sdcardlib.lib / sdhclib.lib / sdbus.lib exist in the
# public lib tree. Set BSP_NOSD=1 (and drop sdhcbcm from ..\dirs) to build
# without the SD stack.

TARGETNAME=sdhcbcm
TARGETTYPE=DYNLINK
DLLENTRY=_DllEntryCRTStartup

PREPROCESSDEFFILE=1
NORELEASEDEFFILE=1

INCLUDES=$(INCLUDES);$(_PUBLICROOT)\common\oak\drivers\sdcard\SDHCDrivers\SDIOStdHC\base

# SDHCBase.lib is a prebuilt public lib (public\common\oak\lib), NOT a project
# cesysgen output, so link it as a TARGETLIBS prebuilt. (The shipped pci PDD
# uses SOURCELIBS/$(_COMMONOAKROOT) because it builds inside the public tree;
# in a BSP that path resolves to cesysgen\oak\lib, where the lib does not
# exist, so build.exe fails with "don't know how to make SDHCBase.lib".)
TARGETLIBS= \
    $(_COREDLL) \
    $(_CEDDK) \
    $(_PUBLICROOT)\common\oak\lib\$(_CPUINDPATH)\SDHCBase.lib \
    $(_PUBLICROOT)\common\oak\lib\$(_CPUINDPATH)\sdcardlib.lib \
    $(_PUBLICROOT)\common\oak\lib\$(_CPUINDPATH)\sdhclib.lib \
    $(_PUBLICROOT)\common\oak\lib\$(_CPUINDPATH)\sdbus.lib \

SOURCES= \
    sdhcbcm.cpp
