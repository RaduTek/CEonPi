# BCM2835 SD host controller driver (src\drivers\sdhcbcm).
#
# Thin PDD over the CE standard SD host controller MDD (SDHCBase.lib) plus the
# SD card/bus helper libs. Building this REQUIRES the SD stack in the OS design
# (SD Bus Driver + SD Memory + Standard SDHC Host Controller catalog items), so
# that SDHCBase.lib / sdcardlib.lib / sdhclib.lib / sdbus.lib exist in the
# public lib tree. Set BSP_NOSD=1 (and drop sdhcbcm from ..\dirs) to build
# without the SD stack.

TARGETNAME=sdhcbcm
TARGETTYPE=DYNLINK
DLLENTRY=_DllEntryCRTStartup

# No PREPROCESSDEFFILE: the .def has no preprocessor directives, and the
# preprocessed copy (obj\...\sdhcbcm.def) came out EMPTY in the Checked and
# Release configurations, so those sdhcbcm.dll builds exported nothing and
# Device Manager refused them ("Failed to load ... dwStatus=0x1" =
# ERROR_INVALID_FUNCTION, no SHC_Init). Only Debug had the exports. Linking
# with sdhcbcm.def directly (as dwchci does) avoids that step.

INCLUDES=$(INCLUDES);$(_PUBLICROOT)\common\oak\drivers\sdcard\SDHCDrivers\SDIOStdHC\base

# SDHCBase.lib must be whole-archive linked (SOURCELIBS) so the SHC_* stream
# entry points and DllEntry it defines are pulled in for the .def to export -
# as TARGETLIBS the linker only keeps referenced objects and the exports come
# out unresolved. It is a prebuilt PUBLIC lib, so give the public path: the
# shipped pci PDD uses $(_COMMONOAKROOT), which in a BSP resolves to the
# project's cesysgen\oak\lib where the lib does not exist.
SOURCELIBS=$(_PUBLICROOT)\common\oak\lib\$(_CPUINDPATH)\SDHCBase.lib

# coredll.lib / ceddk.lib via the explicit SDK path the dwchci driver uses:
# the $(_COREDLL)/$(_CEDDK) macros from the public pci sources are not defined
# in this BSP build, so everything resolved only against them came out
# unresolved (NKDbgPrintfW, EnterCriticalSection, Reg*, KernelIoControl, the
# ceddk bus/DMA helpers, ...).
TARGETLIBS= \
    $(_COMMONSDKROOT)\lib\$(_CPUDEPPATH)\coredll.lib \
    $(_COMMONSDKROOT)\lib\$(_CPUDEPPATH)\ceddk.lib \
    $(_PUBLICROOT)\common\oak\lib\$(_CPUINDPATH)\sdcardlib.lib \
    $(_PUBLICROOT)\common\oak\lib\$(_CPUINDPATH)\sdhclib.lib \
    $(_PUBLICROOT)\common\oak\lib\$(_CPUINDPATH)\sdbus.lib \

SOURCES= \
    sdhcbcm.cpp
