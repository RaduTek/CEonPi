# DesignWare OTG (DWC2) USB host controller driver for the BCM2835.
# Links the CE USB 2.0 host library (hcd2lib), which needs SYSGEN_USB.

TARGETNAME=dwchci
TARGETTYPE=DYNLINK
DLLENTRY=_DllMainCRTStartup

INCLUDES=$(INCLUDES);$(_PUBLICROOT)\common\oak\drivers\usb\hcd\usb20\usb2com

SOURCES= \
    system.cpp \
    dwccore.cpp \
    cdwchcd.cpp \
    cpipe.cpp \
    dwctt.cpp

TARGETLIBS= \
    $(_COMMONSDKROOT)\lib\$(_CPUDEPPATH)\ceddk.lib \
    $(_COMMONSDKROOT)\lib\$(_CPUDEPPATH)\coredll.lib

# hcd2lib.lib is a prebuilt PUBLIC lib, so take it from the public tree. In a
# BSP build $(_COMMONOAKROOT) is the OS design's cesysgen\oak, where the lib
# only exists after sysgen has copied the USB component for that build
# configuration; otherwise the build fails with "U1073: don't know how to
# make ...cesysgen\oak\lib\...\hcd2lib.lib". Same fix as sdhcbcm (SDHCBase.lib).
SOURCELIBS= \
    $(_PUBLICROOT)\common\oak\lib\$(_CPUINDPATH)\hcd2lib.lib
