;
; DesignWare OTG USB host controller driver. Stream interface exports.
; The HCD_* functions are implemented in hcd2lib (hcddrv.cpp).
;
LIBRARY         DWCHCI

EXPORTS         HCD_Init
                HCD_PowerUp
                HCD_PowerDown
                HCD_Deinit
                HCD_Open
                HCD_Close
                HCD_Read
                HCD_Write
                HCD_Seek
                HCD_IOControl
