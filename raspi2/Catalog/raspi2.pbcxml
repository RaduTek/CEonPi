<?xml version="1.0" encoding="utf-8"?>
<CatalogFile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" RequiredVersion="7.00" xmlns="urn:Microsoft.PlatformBuilder/Catalog">
  <FileInformation Id="FileInformation:Boling Consulting Inc.:raspi2">
    <Title>raspi2</Title>
    <Description>raspi2 BSP Catalog Items</Description>
    <Vendor>Boling Consulting Inc.</Vendor>
    <OSVersion>7.00</OSVersion>
    <FileVersion>0.1</FileVersion>
  </FileInformation>
  <Bsp Id="Bsp:Boling Consulting Inc.:raspi2:ARMV6">
    <Title>raspi2: ARMV6</Title>
    <Description>Raspberry Pi BSP based on BSP Template</Description>
    <PlatformDirectory>raspi2</PlatformDirectory>
    <CpuId>Cpu:ARMV6</CpuId>
    <BspItemId>Item:Boling Consulting Inc.:BSPTemplateInstructions:BSPTemplate_raspi2</BspItemId>
    <BspItemId>Item:Boling Consulting Inc.:TemplateBootloader:BSPTemplate_raspi2</BspItemId>
    <BspItemId>Item:Boling Consulting Inc.:TemplateBootloader2:BSPTemplate_raspi2</BspItemId>
    <BspItemId>Item:Boling Consulting Inc.:TemplateBSPConfigFiles:BSPTemplate_raspi2</BspItemId>
    <BspItemId>Item:Boling Consulting Inc.:TemplateOAL:BSPTemplate_raspi2</BspItemId>
    <BspItemId>Item:Boling Consulting Inc.:TemplateKITL:BSPTemplate_raspi2</BspItemId>
    <BspItemId>Item:Boling Consulting Inc.:TemplateStreamDriver:BSPTemplate_raspi2</BspItemId>
    <BspItemId>Item:Boling Consulting Inc.:TutorialPlatformCommon:BSPTemplate_raspi2</BspItemId>
    <BspItemId>Item:Boling Consulting Inc.:TutorialKitlEthernet:BSPTemplate_raspi2</BspItemId>
    <BspItemId>Item:Boling Consulting Inc.:TutorialKitlEthernetPlatformCommon:BSPTemplate_raspi2</BspItemId>
    <BspItemId>Item:Boling Consulting Inc.:TutorialHALFlatDisplayDriver:BSPTemplate_raspi2</BspItemId>
    <BspItemId>Item:CEonPi:IdleMon:raspi2</BspItemId>
    <BspItemId>Item:CEonPi:PowerOff:raspi2</BspItemId>
    <BspItemId>Item:CEonPi:SdRoot:raspi2</BspItemId>
    <BspItemId>Item:CEonPi:SdOffload:raspi2</BspItemId>
    <BspItemId>Item:CEonPi:Audio:raspi2</BspItemId>
  </Bsp>
  <Item Id="Item:Boling Consulting Inc.:BSPTemplateInstructions:BSPTemplate_raspi2">
    <Title>!BSP Template Instructions - Start Here!</Title>
    <Description>BSP Template Instructions</Description>
    <Type>BspSpecific</Type>
    <ChooseOneGroup>true</ChooseOneGroup>
    <Location />
    <SourceCode>
      <Title>BSP TEMPLATE INSTRUCTIONS</Title>
      <Path>$(_WINCEROOT)\PLATFORM\RASPI2\INSTRUCTIONS</Path>
    </SourceCode>
  </Item>
  <Item Id="Item:Boling Consulting Inc.:TemplateKITL:BSPTemplate_raspi2">
    <Title>Template KITL</Title>
    <Description>KITL Template</Description>
    <Type>BspSpecific</Type>
    <ChooseOneGroup>true</ChooseOneGroup>
    <Location />
    <SourceCode>
      <Title>TEMPLATE KITL SOURCE CODE</Title>
      <Path>$(_WINCEROOT)\PLATFORM\RASPI2\SRC\KITL</Path>
    </SourceCode>
  </Item>
  <Item Id="Item:CEonPi:IdleMon:raspi2">
    <Title>CPU Idle Monitor (demo)</Title>
    <Description>Small window showing CPU load, idle percentage and GetIdleTime(), with a desktop shortcut. Sets BSP_IDLEMON=1.</Description>
    <Type>BspSpecific</Type>
    <Variable>BSP_IDLEMON</Variable>
    <Location>Applications</Location>
    <SourceCode>
      <Title>CPU IDLE MONITOR SOURCE CODE</Title>
      <Path>$(_WINCEROOT)\PLATFORM\RASPI2\SRC\APPS\IDLEMON</Path>
    </SourceCode>
  </Item>
  <Item Id="Item:CEonPi:PowerOff:raspi2">
    <Title>Shut Down dialog (poweroff.exe)</Title>
    <Description>Dialog with Restart, Power off and Cancel buttons, with a desktop shortcut. Sets BSP_POWEROFF=1.</Description>
    <Type>BspSpecific</Type>
    <Variable>BSP_POWEROFF</Variable>
    <Location>Applications</Location>
    <SourceCode>
      <Title>SHUT DOWN DIALOG SOURCE CODE</Title>
      <Path>$(_WINCEROOT)\PLATFORM\RASPI2\SRC\APPS\POWEROFF</Path>
    </SourceCode>
  </Item>
  <Item Id="Item:CEonPi:SdRoot:raspi2">
    <Title>SD card as root file system</Title>
    <Description>Mounts the SD card (the FAT boot partition) as the root file system instead of \Storage Card. Its Windows folder is merged into \Windows over the ROM image, and files on the card persist across reboots. The SD drivers load in boot phase 1. Requires the SD host driver. Sets BSP_SDROOT=1.</Description>
    <Type>BspSpecific</Type>
    <Variable>BSP_SDROOT</Variable>
    <Location>Storage</Location>
    <SourceCode>
      <Title>SD ROOT REGISTRY SETTINGS</Title>
      <Path>$(_WINCEROOT)\PLATFORM\RASPI2\FILES</Path>
    </SourceCode>
  </Item>
  <Item Id="Item:CEonPi:SdOffload:raspi2">
    <Title>Load optional modules from the SD card</Title>
    <Description>Leaves the modules listed as "; SDOFFLOAD" in platform.bib (IE7 stack, network command-line tools) out of kernel.img and copies them to the Windows folder of the sdcard build folder, so they load from the SD card and take no RAM until used. Requires "SD card as root file system". Sets BSP_SDOFFLOAD=1.</Description>
    <Type>BspSpecific</Type>
    <Variable>BSP_SDOFFLOAD</Variable>
    <Location>Storage</Location>
    <SourceCode>
      <Title>SD OFFLOAD LIST AND SCRIPTS</Title>
      <Path>$(_WINCEROOT)\PLATFORM\RASPI2\FILES</Path>
    </SourceCode>
  </Item>
  <Item Id="Item:CEonPi:Audio:raspi2">
    <Title>Analog audio (Pi 1 3.5 mm jack)</Title>
    <Description>PWM audio driver (pwmaudio.dll) for the 3.5 mm jack of the Pi 1 Model B/B+/A+ (GPIO40/45 PWM fed by DMA). The Pi Zero has no jack. Requires the Waveform Audio catalog item (SYSGEN_AUDIO). Sets BSP_AUDIO=1.</Description>
    <Type>BspSpecific</Type>
    <Variable>BSP_AUDIO</Variable>
    <Location>Device Drivers\Audio</Location>
    <SourceCode>
      <Title>PWM AUDIO DRIVER SOURCE CODE</Title>
      <Path>$(_WINCEROOT)\PLATFORM\RASPI2\SRC\DRIVERS\PWMAUDIO</Path>
    </SourceCode>
  </Item>
</CatalogFile>