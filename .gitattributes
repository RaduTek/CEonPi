* text=auto
# Build-system and source files: LF in the repo, CRLF in the working tree
dirs         text eol=crlf
sources      text eol=crlf
makefile     text eol=crlf
*.cmn        text eol=crlf
*.c          text eol=crlf
*.cpp        text eol=crlf
*.h          text eol=crlf
*.s          text eol=crlf
*.inc        text eol=crlf
*.def        text eol=crlf
*.bib        text eol=crlf
*.reg        text eol=crlf
*.dat        text eol=crlf
*.bat        text eol=crlf
*.js         text eol=crlf
*.proj       text eol=crlf
*.sln        text eol=crlf
*.pbxml      text eol=crlf
*.pbcxml     text eol=crlf
*.html       text eol=crlf
*.rc         text eol=crlf
platform.db  text eol=crlf
OSDesign.db  text eol=crlf
# Binary files: never touch
*.bmp        binary
*.ico        binary
*.suo        binary
Thumbs.db    binary
# Raspberry Pi firmware (Broadcom, see raspi2/files/sdboot/LICENCE.broadcom).
# Must come after the *.dat rule above: fixup.dat is binary, not a CE .dat file.
raspi2/files/sdboot/*.bin  binary
raspi2/files/sdboot/*.elf  binary
raspi2/files/sdboot/*.dat  binary
